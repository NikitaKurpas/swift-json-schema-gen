{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pet",
  "description": "A pet returned by the example service.",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "name"
  ]
}
